{
  "name": "@prashant-rajpurohit/trpc-inspector-sdk",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prashant-rajpurohit/trpc-inspector-core": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@prashant-rajpurohit/trpc-inspector-bridge": "workspace:*",
    "@types/ws": "^8.18.2"
  }
}
